<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Legenda della mappa topografica libera basata sui dati OpenStreetMap.">
    <meta name="keywords" content="open, topo, map, maps, openstreetmap, osm, srtm, topografica, curve di livello, dati altimetrici, SRTM, libero">
    <title>Legenda della mappa OpenTopoMap</title>
    <link rel="icon" href="favicon.ico" type="image/x-icon"/>
    <link href="style.css" type="text/css" rel="stylesheet"/>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #333;
            line-height: 1.6;
            margin: 20px;
            background-color: #f9f9f9;
        }

        header h1 {
            color: #00386b;
            text-align: center;
            margin-bottom: 30px;
        }

        .legend-section {
            margin-bottom: 20px;
            background-color: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .legend-title {
            font-size: 1.2em;
            font-variant: small-caps;
            font-weight: bold;
            margin-top: 15px;
            margin-bottom: 15px;
            display: block;
            color: #005691;
            border-bottom: 2px solid #eee;
            padding-bottom: 5px;
        }
        
        /* elementi della legenda */
        .legend-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-wrap: wrap;
            font-size: 0.9em;
        }

        /* icona / testo */
        .legend-item {
            display: flex;
            align-items: center;
            width: 30%; /* Per visualizzare 3 colonne */
            min-width: 180px; 
            padding: 5px 10px 5px 0;
        }

        .legend-item img {
            margin-right: 8px;
            height: 20px;
            object-fit: contain;
            flex-shrink: 0;
        }

        /* Stile per linee, strade e sentieri */
        .line-and-path-img img {
            height: auto;
            max-height: 20px; 
            width: auto; 
        }

        /* per strade e sentieri */
        .roads-paths-list {
            display: grid;
            grid-template-columns: 1fr 1fr; /* 2 colonne */
            gap: 10px 20px;
            list-style: none;
            padding: 0;
            margin: 0;
            font-size: 0.9em;
        }

        .roads-paths-item {
            display: flex;
            align-items: center;
            padding: 5px 0;
        }
        
        .roads-paths-item img {
            margin-right: 8px;
            height: auto;
            max-height: 20px;
            width: auto;
            object-fit: contain;
            flex-shrink: 0;
        }

        hr {
            border: none;
            border-top: 1px solid #eee;
            margin: 30px 0;
        }
    </style>
</head>
<body>

    <header>
        <h1>Legenda della mappa OpenTopoMap</h1>
    </header>

    <div class="legend-section">
        <span class="legend-title">Superfici e Aree</span>
        <ul class="legend-list">
            <li class="legend-item"><img src="./legend-images/laubwald.png" alt="Bosco di latifoglie">Bosco di latifoglie</li>
            <li class="legend-item"><img src="./legend-images/nadelwald.png" alt="Bosco di conifere">Bosco di conifere</li>
            <li class="legend-item"><img src="./legend-images/mischwald.png" alt="Bosco misto">Bosco misto</li>

            <li class="legend-item"><img src="./legend-images/sumpf.png" alt="Palude">Palude</li>
            <li class="legend-item"><img src="./legend-images/moor.png" alt="Torbiera">Torbiera, Acquitrino</li>
            <li class="legend-item"><img src="./legend-images/roehricht.png" alt="Canneto">Canneto</li>

            <li class="legend-item"><img src="./legend-images/watt.png" alt="Piana di marea">Piana di marea / Zona intertidale</li>
            <li class="legend-item"><img src="./legend-images/sand.png" alt="Sabbia">Spiaggia, Sabbia</li>
            <li class="legend-item"><img src="./legend-images/geroell.png" alt="Ghiaione">Ghiaione / Pierrier</li>

            <li class="legend-item"><img src="./legend-images/gehoelz.png" alt="Boschetto">Boschetto / Area boscata</li>
            <li class="legend-item"><img src="./legend-images/wiese.png" alt="Prato">Prato / Pascolo</li>
            <li class="legend-item"></li>
            
            <li class="legend-item"><img src="./legend-images/wein.png" alt="Vigneto">Vigneto</li>
            <li class="legend-item"><img src="./legend-images/friedhof.png" alt="Cimitero">Cimitero</li>
            <li class="legend-item"><img src="./legend-images/schrebergarten.png" alt="Orti urbani">Orti urbani</li>

            <li class="legend-item"><img src="./legend-images/sperrgebiet.png" alt="Zona ad accesso limitato">Zona ad accesso limitato</li>
            <li class="legend-item"><img src="./legend-images/bergbau.png" alt="Miniera">Miniera, Cava</li>
        </ul>
    </div>
    
    <hr/>

    <div class="legend-section">
        <span class="legend-title">Linee</span>
        <ul class="legend-list">
            
            <li class="legend-item line-and-path-img"><img src="./legend-images/stromleitung.png" alt="Linea elettrica">Linea elettrica</li>
            <li class="legend-item line-and-path-img"><img src="./legend-images/seilbahn.png" alt="Impianto di risalita">Funivia / Impianto di risalita</li>
            <li class="legend-item line-and-path-img"></li> 

            <li class="legend-item line-and-path-img"><img src="./legend-images/boeschung.png" alt="Scarpata">Scarpata</li>
            <li class="legend-item line-and-path-img"><img src="./legend-images/deich.png" alt="Argine">Argine / Diga</li>
            <li class="legend-item line-and-path-img"></li> 

            <li class="legend-item line-and-path-img"><img src="./legend-images/zaun.png" alt="Recinzione">Recinzione / Staccionata</li>
            <li class="legend-item line-and-path-img"><img src="./legend-images/hecke.png" alt="Siepe">Siepe</li>
        </ul>
    </div>

    <hr/>

    <div class="legend-section">
        <span class="legend-title">Strade e Sentieri</span>
        <ul class="roads-paths-list">
            <li class="roads-paths-item"><img src="./legend-images/autobahn.png" alt="Autostrada">Autostrada, Strada statale</li>
            <li class="roads-paths-item"><img src="./legend-images/landstrasse.png" alt="Strada rurale">Strada provinciale / rurale</li>

            <li class="roads-paths-item"><img src="./legend-images/normalestrasse.png" alt="Via locale">Strada locale, Via</li>
            <li class="roads-paths-item"><img src="./legend-images/strassenimbau.png" alt="In costruzione">Strada in costruzione</li>

            <li class="roads-paths-item"><img src="./legend-images/service.png" alt="Strada di servizio">Strada di servizio / accesso</li>
            <li class="roads-paths-item"><img src="./legend-images/track_grade1.png" alt="Pista asfaltata">Strada asfaltata / pavimentata</li>

            <li class="roads-paths-item"><img src="./legend-images/track_grade2.png" alt="Pista sterrata">Strada sterrata (ghiaia), Ciclabile</li>
            <li class="roads-paths-item"><img src="./legend-images/track_grade34.png" alt="Superficie cedevole">Strada agricola (superficie cedevole)</li>

            <li class="roads-paths-item"><img src="./legend-images/track_grade5.png" alt="Strada campestre">Strada campestre / non asfaltata</li>
            <li class="roads-paths-item"><img src="./legend-images/bobsleigh.png" alt="Pista da bob">Pista da bob</li>

            <li class="roads-paths-item"><img src="./legend-images/toboggan.png" alt="Slittino estivo">Pista da slittino estivo</li>
            <li class="roads-paths-item"><img src="./legend-images/fussweg_t12.png" alt="Sentiero">Sentiero pedonale</li>

            <li class="roads-paths-item"><img src="./legend-images/fussweg_t34.png" alt="Sentiero difficile">Sentiero difficile (scala SAC T3 T4)</li>
            <li class="roads-paths-item"><img src="./legend-images/fussweg_t56.png" alt="Via ferrata">Sentiero molto difficile (SAC T5 T6), Via ferrata</li>
        </ul>
    </div>

    <hr/>

    <div class="legend-section">
        <span class="legend-title">Simboli</span>
        <ul class="legend-list">
            <li class="legend-item"><img src="./legend-images/kirche.png" alt="Chiesa">Chiesa</li>
            <li class="legend-item"><img src="./legend-images/kapelle.png" alt="Cappella">Cappella</li>
            <li class="legend-item"><img src="./legend-images/burg.png" alt="Castello">Castello, Fortezza</li>

            <li class="legend-item"><img src="./legend-images/burgruine.png" alt="Rovine">Ruderi di castello, Rovine</li>
            <li class="legend-item"><img src="./legend-images/schloss.png" alt="Palazzo">Palazzo, Villa storica</li>
            <li class="legend-item"><img src="./legend-images/schlossruine.png" alt="Rovine di palazzo">Ruderi di palazzo</li>

            <li class="legend-item"><img src="./legend-images/sportplatz.png" alt="Campo sportivo">Campo sportivo</li>
            <li class="legend-item"><img src="./legend-images/stadion.png" alt="Stadio">Stadio</li>
            <li class="legend-item"><img src="./legend-images/turm.png" alt="Torre">Torre</li>

            <li class="legend-item"><img src="./legend-images/aussichtsturm.png" alt="Belvedere">Torre di osservazione / Belvedere</li>
            <li class="legend-item"><img src="./legend-images/wasserturm.png" alt="Serbatoio pensile">Serbatoio pensile / Torre dell'acqua</li>
            <li class="legend-item"><img src="./legend-images/sendeturm.png" alt="Ripetitore">Torre telecomunicazioni / Ripetitore</li>

            <li class="legend-item"><img src="./legend-images/mobilfunkmast.png" alt="Antenna cellulare">Antenna telefonia mobile</li>
            <li class="legend-item"><img src="./legend-images/leuchtturm.png" alt="Faro">Faro</li>
            <li class="legend-item"><img src="./legend-images/aussichtspunkt.png" alt="Punto panoramico">Punto panoramico</li>

            <li class="legend-item"><img src="./legend-images/badestelle.png" alt="Zona balneabile">Piscina, Zona balneabile</li>
            <li class="legend-item"><img src="./legend-images/camping.png" alt="Campeggio">Campeggio</li>
            <li class="legend-item"><img src="./legend-images/bergwerk.png" alt="Miniera">Miniera</li>

            <li class="legend-item"><img src="./legend-images/bergwerk_stillgelegt.png" alt="Miniera dismessa">Miniera (dismessa)</li>
            <li class="legend-item"><img src="./legend-images/muehle.png" alt="Mulino">Mulino</li>
            <li class="legend-item"><img src="./legend-images/unterstand.png" alt="Riparo">Riparo / Tettoia</li>

            <li class="legend-item"><img src="./legend-images/huette.png" alt="Rifugio">Rifugio / Baita</li>
            <li class="legend-item"><img src="./legend-images/huette_bewirtschaftet.png" alt="Rifugio gestito">Rifugio (gestito)</li>
            <li class="legend-item"><img src="./legend-images/denkmal.png" alt="Monumento">Monumento, Memoriale</li>

            <li class="legend-item"><img src="./legend-images/wegkreuz.png" alt="Croce viaria">Croce viaria</li>
            <li class="legend-item"><img src="./legend-images/huegelgrab.png" alt="Tumulo">Tumulo</li>
            <li class="legend-item"><img src="./legend-images/gipfel.png" alt="Vetta">Vetta / Cima</li>

            <li class="legend-item"><img src="./legend-images/gipfelkreuz.png" alt="Croce di vetta">Croce di vetta</li>
            <li class="legend-item"><img src="./legend-images/quelle.png" alt="Sorgente">Sorgente</li>
            <li class="legend-item"><img src="./legend-images/hoehle.png" alt="Ingresso grotta">Ingresso di grotta</li>

            <li class="legend-item"><img src="./legend-images/kreuz.png" alt="Croce">Croce</li>
            <li class="legend-item"><img src="./legend-images/sattel.png" alt="Passo">Passo / Valico / Sella</li>
            <li class="legend-item"><img src="./legend-images/laubbaum.png" alt="Albero monumentale">Albero monumentale</li>
            <li class="legend-item"><img src="./legend-images/doline.png" alt="Dolina">Dolina</li>
            <li class="legend-item"><img src="./legend-images/kraftwerk.png" alt="Centrale elettrica">Centrale elettrica</li>
            <li class="legend-item"><img src="./legend-images/photovoltaikanlage.png" alt="Fotovoltaico">Impianto fotovoltaico</li>

            <li class="legend-item"><img src="./legend-images/windkraftanlage.png" alt="Turbina eolica">Turbina eolica</li>
            <li class="legend-item"><img src="./legend-images/schornstein.png" alt="Ciminiera">Ciminiera</li>
        </ul>
    </div>
</body>
</html>
